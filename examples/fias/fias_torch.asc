#include <pybind11/pybind11.h>
#include <torch/extension.h>
#include <torch_npu/csrc/core/npu/NPUStream.h>
#include "fias_tiling.h"
#include "kernel_operator.h"

// IFA kernel entry headers
#define FIA_ENABLE_MLA
#define ORIG_DTYPE_QUERY DT_BF16
#define ORIG_DTYPE_KEY DT_BF16
#define ORIG_DTYPE_ATTENTION_OUT DT_BF16
#define NOT_DYNAMIC_COMPILE
#include "attention/fused_infer_attention_score/op_kernel/fused_infer_attention_score_template_tiling_key.h"
#include "attention/incre_flash_attention/op_kernel/arch35/incre_flash_attention_entry_regbase.h"

#include "fias_torch.h"

namespace py = pybind11;
using namespace fias;

// ============================================================================
// Named kernel functions
// Each bakes in specific template parameter values and passes tiling by value.
// The tiling struct is placed in GM input parameter buffer by the runtime,
// so &tilingData yields a valid __gm__ pointer for the IFA entry.
// ============================================================================

// Helper macro to define a FIAS kernel wrapper
#define DEFINE_FIAS_KERNEL(name, inOutLayout, config, pseMode, quantMode, \
                           hasMask, hasRope, isPa, isFd, emptyTensor,     \
                           pfaMask, pfaMatMulType, enableKVPrefix)         \
    __global__ __aicore__ void name(                                       \
        __gm__ uint8_t *query, __gm__ uint8_t *key,                       \
        __gm__ uint8_t *value, __gm__ uint8_t *pse_shift,                 \
        __gm__ uint8_t *attenMask, __gm__ uint8_t *actualSeqLengths,      \
        __gm__ uint8_t *actualSeqLengthsKV,                               \
        __gm__ uint8_t *deq_scale1, __gm__ uint8_t *quant_scale1,         \
        __gm__ uint8_t *deq_scale2, __gm__ uint8_t *quant_scale2,         \
        __gm__ uint8_t *quant_offset2, __gm__ uint8_t *antiquantScale,    \
        __gm__ uint8_t *antiquantOffset, __gm__ uint8_t *blocktable,      \
        __gm__ uint8_t *queryPaddingSize, __gm__ uint8_t *kvPaddingSize,  \
        __gm__ uint8_t *keyAntiquantScale,                                \
        __gm__ uint8_t *keyAntiquantOffset,                               \
        __gm__ uint8_t *valueAntiquantScale,                              \
        __gm__ uint8_t *valueAntiquantOffset,                             \
        __gm__ uint8_t *keySharedPrefix,                                  \
        __gm__ uint8_t *valueSharedPrefix,                                \
        __gm__ uint8_t *actualSharedPrefixLen,                            \
        __gm__ uint8_t *attentionOut, __gm__ uint8_t *softmaxLse,        \
        __gm__ uint8_t *workspace,                                        \
        FiasTilingData tilingData)                                         \
    {                                                                      \
        incre_flash_attention_FIAS_regbase<                                \
            inOutLayout, config, pseMode, quantMode,                       \
            hasMask, hasRope, isPa, isFd, emptyTensor,                     \
            pfaMask, pfaMatMulType, enableKVPrefix>(                        \
            query, key, value, pse_shift, attenMask,                       \
            actualSeqLengths, actualSeqLengthsKV,                          \
            deq_scale1, quant_scale1, deq_scale2, quant_scale2,            \
            quant_offset2, antiquantScale, antiquantOffset,                \
            blocktable, queryPaddingSize, kvPaddingSize,                   \
            keyAntiquantScale, keyAntiquantOffset,                         \
            valueAntiquantScale, valueAntiquantOffset,                     \
            keySharedPrefix, valueSharedPrefix, actualSharedPrefixLen,     \
            attentionOut, softmaxLse, workspace,                           \
            (__gm__ uint8_t *)&tilingData);                                \
    }

// BF16 BNSD Config1 (D=64) variants
//                                 name,  layout, config, pse, quant, mask, rope, pa, fd, empty, pfaMask, pfaMMT, kvPfx
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C1_NoMask_NoPA_NoFD,  0, 1, 9, 31, false, false, false, false, false, 0, 0, false)
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C1_Mask_NoPA_NoFD,    0, 1, 9, 31, true,  false, false, false, false, 0, 0, false)
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C1_NoMask_PA_NoFD,    0, 1, 9, 31, false, false, true,  false, false, 0, 0, false)
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C1_Mask_PA_NoFD,      0, 1, 9, 31, true,  false, true,  false, false, 0, 0, false)

// BF16 BNSD Config3 (D=128) variants
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C3_NoMask_NoPA_NoFD,  0, 3, 9, 31, false, false, false, false, false, 0, 0, false)
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C3_Mask_NoPA_NoFD,    0, 3, 9, 31, true,  false, false, false, false, 0, 0, false)
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C3_NoMask_PA_NoFD,    0, 3, 9, 31, false, false, true,  false, false, 0, 0, false)
DEFINE_FIAS_KERNEL(FiasKernel_BF16_BNSD_C3_Mask_PA_NoFD,      0, 3, 9, 31, true,  false, true,  false, false, 0, 0, false)

// ============================================================================
// Kernel dispatch helper
// ============================================================================
#define FIAS_KERNEL_LAUNCH(kernelFunc, blockDim, stream, ...) \
    kernelFunc<<<blockDim, nullptr, stream>>>(__VA_ARGS__)

// ============================================================================
// Main pybind function
// ============================================================================
torch::Tensor fias_decode(
    torch::Tensor query, torch::Tensor key, torch::Tensor value,
    c10::optional<torch::Tensor> atten_mask,
    c10::optional<torch::Tensor> actual_seq_lengths,
    c10::optional<torch::Tensor> actual_seq_lengths_kv,
    c10::optional<torch::Tensor> block_table,
    int64_t num_heads, int64_t num_kv_heads,
    double scale_value, int64_t pre_tokens, int64_t next_tokens,
    std::string input_layout, int64_t block_size,
    int64_t sparse_mode, int64_t inner_precise,
    bool softmax_lse_flag)
{
    // 1. Check tensors on NPU
    checkTensorOnNPU(query, "query", false);
    checkTensorOnNPU(key, "key", false);
    checkTensorOnNPU(value, "value", false);
    checkTensorOnNPU(atten_mask, "atten_mask", true);
    checkTensorOnNPU(actual_seq_lengths, "actual_seq_lengths", true);
    checkTensorOnNPU(actual_seq_lengths_kv, "actual_seq_lengths_kv", true);
    checkTensorOnNPU(block_table, "block_table", true);

    // 2. Build tensor descriptors
    std::vector<FiasTensorDescTiling> inTensors;
    AddTensorDesc(query, "query", inTensors, false);
    AddTensorDesc(key, "key", inTensors, false);
    AddTensorDesc(value, "value", inTensors, false);
    AddTensorDesc(atten_mask, "atten_mask", inTensors, true);
    AddTensorDesc(actual_seq_lengths, "actual_seq_lengths", inTensors, true);
    AddTensorDesc(actual_seq_lengths_kv, "actual_seq_lengths_kv", inTensors, true);
    AddTensorDesc(block_table, "block_table", inTensors, true);

    // 3. Build attributes
    FiasAttrTiling attrs = {
        .numHeads = num_heads,
        .numKVHeads = num_kv_heads,
        .scaleValue = scale_value,
        .preTokens = pre_tokens,
        .nextTokens = next_tokens,
        .inputLayout = input_layout,
        .blockSize = block_size,
        .sparseMode = sparse_mode,
        .innerPrecise = inner_precise,
        .softmaxLseFlag = softmax_lse_flag,
    };

    // 4. Allocate output tensor (same shape as query for BNSD)
    auto outShape = query.sizes().vec();
    // Output D dimension matches value's D (dSizeV)
    outShape.back() = value.size(-1);
    at::Tensor attentionOut = at::empty(outShape,
                                        at::dtype(query.scalar_type())
                                            .device(query.device())
                                            .layout(query.layout()));

    // 5. Build output descriptors
    std::vector<FiasTensorDescTiling> outTensors;
    AddTensorDesc(attentionOut, "attentionOut", outTensors, false);

    // 6. Compute tiling
    FiasTilingData tilingData = {};
    FiasTiling opTiling(&tilingData);
    uint64_t tilingKey = 0;
    uint64_t workspaceSize = 0;
    uint64_t blockDim = 0;
    bool ret = opTiling.DoTiling(inTensors, attrs, outTensors, tilingKey, workspaceSize, blockDim);
    TORCH_CHECK(ret, "FiasTiling::DoTiling failed");

    // 7. Allocate workspace
    void *workspacePtr = nullptr;
    if (workspaceSize > 0) {
        auto acl_ret = aclrtMalloc(&workspacePtr, workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);
        TORCH_CHECK(acl_ret == ACL_SUCCESS, "allocate workspace failed. ERROR: ", acl_ret);
    }

    // 8. Get stream and tensor addresses
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto q_ptr = (uint8_t *)get_first_tensor_address(query, false);
    auto k_ptr = (uint8_t *)get_first_tensor_address(key, false);
    auto v_ptr = (uint8_t *)get_first_tensor_address(value, false);
    auto mask_ptr = (uint8_t *)get_first_tensor_address(atten_mask, true);
    auto seq_len_ptr = (uint8_t *)get_first_tensor_address(actual_seq_lengths, true);
    auto seq_len_kv_ptr = (uint8_t *)get_first_tensor_address(actual_seq_lengths_kv, true);
    auto bt_ptr = (uint8_t *)get_first_tensor_address(block_table, true);
    auto out_ptr = (uint8_t *)get_first_tensor_address(attentionOut, false);

    // 9. Dispatch to named kernel based on tilingKey
    // All unused GM pointers passed as nullptr
    #define FIAS_LAUNCH(kernelFunc)                                        \
        FIAS_KERNEL_LAUNCH(kernelFunc, blockDim, stream,                   \
            q_ptr, k_ptr, v_ptr,                                           \
            nullptr,      /* pse_shift */                                  \
            mask_ptr,     /* attenMask */                                  \
            seq_len_ptr,  /* actualSeqLengths (used as Q seq lens) */      \
            seq_len_kv_ptr,/* actualSeqLengthsKV */                        \
            nullptr, nullptr, nullptr, nullptr, nullptr,                   \
            nullptr, nullptr,                                              \
            bt_ptr,       /* blocktable */                                 \
            nullptr, nullptr,                                              \
            nullptr, nullptr, nullptr, nullptr,                            \
            nullptr, nullptr, nullptr,                                     \
            out_ptr,      /* attentionOut */                                \
            nullptr,      /* softmaxLse */                                 \
            (uint8_t *)workspacePtr,                                       \
            tilingData)

    switch (tilingKey) {
        case FIAS_BF16_BNSD_C1_NOMASK_NOPA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C1_NoMask_NoPA_NoFD);
            break;
        case FIAS_BF16_BNSD_C1_MASK_NOPA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C1_Mask_NoPA_NoFD);
            break;
        case FIAS_BF16_BNSD_C1_NOMASK_PA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C1_NoMask_PA_NoFD);
            break;
        case FIAS_BF16_BNSD_C1_MASK_PA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C1_Mask_PA_NoFD);
            break;
        case FIAS_BF16_BNSD_C3_NOMASK_NOPA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C3_NoMask_NoPA_NoFD);
            break;
        case FIAS_BF16_BNSD_C3_MASK_NOPA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C3_Mask_NoPA_NoFD);
            break;
        case FIAS_BF16_BNSD_C3_NOMASK_PA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C3_NoMask_PA_NoFD);
            break;
        case FIAS_BF16_BNSD_C3_MASK_PA_NOFD:
            FIAS_LAUNCH(FiasKernel_BF16_BNSD_C3_Mask_PA_NoFD);
            break;
        default:
            if (workspaceSize > 0) aclrtFree(workspacePtr);
            TORCH_CHECK(false, "unsupported tilingKey: ", tilingKey);
    }
    #undef FIAS_LAUNCH

    // 10. Free workspace
    if (workspaceSize > 0) {
        aclrtFree(workspacePtr);
    }

    return attentionOut;
}

// ============================================================================
// pybind11 module registration
// ============================================================================
PYBIND11_MODULE(ascendc_ops, m) {
    m.def("fias_decode", &fias_decode, "Fused Infer Attention Score (decode)",
        py::arg("query"),
        py::arg("key"),
        py::arg("value"),
        py::arg("atten_mask") = py::none(),
        py::arg("actual_seq_lengths") = py::none(),
        py::arg("actual_seq_lengths_kv") = py::none(),
        py::arg("block_table") = py::none(),
        py::arg("num_heads") = 1,
        py::arg("num_kv_heads") = 1,
        py::arg("scale_value") = 1.0,
        py::arg("pre_tokens") = 65536,
        py::arg("next_tokens") = 0,
        py::arg("input_layout") = "BNSD",
        py::arg("block_size") = 0,
        py::arg("sparse_mode") = 0,
        py::arg("inner_precise") = 0,
        py::arg("softmax_lse_flag") = false
    );
}
