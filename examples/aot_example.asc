/******************************************************************************
 * Static Tensor 算子 - 使用 DataCopyPad 和 DataCopy 接口
 * 
 * 功能：将输入 x 通过 DataCopyPad 拷贝到 UB，再通过 DataCopy 拷贝到输出 y
 * 数据：64 个 float (256 字节)
 * DataCopyPad 参数：blockLen=20字节, blockCount=8
 ******************************************************************************/

/******************************************************************************
 * PART 1: KERNEL CODE (NPU AI Core Execution)
 *****************************************************************************/

#include "kernel_operator.h"
#include "framework.h"
#include "tile_copy.h"

using namespace AscendC;

/*
  M,N ==> M 行，N 列，横向有N个元素，纵向有M个元素
*/

/******************************************************************************
 * 通用常量折叠框架 - Universal Constant Folding Framework
 * C++17 兼容版本：使用全局 constexpr 变量 + 指针
 *****************************************************************************/

#define OP_ADD 1 // 计算y = x1 + x2
#define OP_RDS 2 // 计算y = ReduceSum(x1)

struct VecOpTiling {
    int32_t m;
    int32_t n;
    int32_t op;
};


// ========== 1.2 AOT Holder 定义 ==========

static constexpr uint8_t AOT_VecOpTiling_32x32_add_Value[] = {
      32, 0, 0, 0,   // m = 32
      32, 0, 0, 0,   // n = 32
      1, 0, 0, 0    // op = 1 (OP_ADD)
  };
using AOT_VecOpTiling_32x32_add = AOTHolder<VecOpTiling, AOT_VecOpTiling_32x32_add_Value>;

static constexpr uint8_t AOT_VecOpTiling_16x16_rds_Value[] = {
      16, 0, 0, 0,   // m = 16
      16, 0, 0, 0,   // n = 16
      2, 0, 0, 0    // op = 2 (OP_RDS)
  };
using AOT_VecOpTiling_16x16_rds = AOTHolder<VecOpTiling, AOT_VecOpTiling_16x16_rds_Value>;

// VecOpTiling AOT 注册表
using VecOpTilingAOTRegistry = AOTRegistry<
    AOT_VecOpTiling_32x32_add,
    AOT_VecOpTiling_16x16_rds
>;

template <typename T, int BM, int BN, typename TH=TilingRuntimeHolder>
__global__ __vector__ void tile_compute(__gm__ uint8_t* x1, __gm__ uint8_t* x2, __gm__ uint8_t* y, VecOpTiling t)
{
    static_assert(sizeof(VecOpTiling) == 12, "VecOpTiling size is not equal 12");
    const VecOpTiling *tiling = GetTiling<VecOpTiling, TH>(&t);
    int m = tiling->m;
    int n = tiling->n;
    int OP = tiling->op;
    if (OP == OP_RDS) {
        assert(sizeof(T) * BN <= 256, "BN can not large than data size of 256\n");
    }
    SetMaskNorm();
    SetAtomicNone();
    GlobalTensor<T> x1_global;
    x1_global.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1));
    GlobalTensor<T> x2_global;
    x2_global.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2));
    GlobalTensor<T> y_global;
    y_global.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y));
    LocalTensor<T> x1_tmp(AscendC::TPosition::VECIN, 0, BM * BN * sizeof(T));
    LocalTensor<T> x2_tmp(AscendC::TPosition::VECIN, BM * BN * sizeof(T), BM * BN * sizeof(T));
    if (OP == OP_RDS) {
        Duplicate<T>(x2_tmp, 0.0, BM * BN);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
    }
    if (OP == OP_ADD) {
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }
    int MC = (m + BM - 1) / BM;
    int NC = (n + BN - 1) / BN;
    int n_stride = n > BN ? n - BN : 0;
    DataFr<T, BM, BN> dfr(m, n);
    for (int bx = 0; bx < MC; bx++) {
        for (int by = 0; by < NC; by++) {
            if (OP == OP_ADD) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
            }
            if (OP == OP_RDS) {
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
            }
            dfr.Load(x1_global, bx, by, x1_tmp, 0.3);
            if (OP == OP_ADD) {
                dfr.Load(x2_global, bx, by, x2_tmp, 0.3);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            if (OP == OP_ADD) {
                Add<T>(x2_tmp, x1_tmp, x2_tmp, BM * BN);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
                GlobalTensor<T> y_global;
                y_global.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y));
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID2);
                dfr.Store(y_global, bx, by, x2_tmp);
                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
            }
            if (OP == OP_RDS) {
                if (dfr.GetMaskCount(bx, by) == BN) {
                    Add<T>(x2_tmp, x1_tmp, x2_tmp, dfr.GetRowCount(bx, by) * BN);
                } else {
                    for (int i = 0; i < dfr.GetRowCount(bx, by); i++) {
                        Add<T>(x2_tmp[i * BN], x1_tmp[i * BN], x2_tmp[i * BN], dfr.GetMaskCount(bx, by));
                    }
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
            }
        }
        if (OP == OP_RDS) {
            LocalTensor<T> x3_tmp(AscendC::TPosition::VECIN, BM * BN * sizeof(T) * 2, BM * BN * sizeof(T));
            PipeBarrier<PIPE_V>();
            for (int i = 0; i < BM; i++) {
                WholeReduceSum<T>(x3_tmp[i], x2_tmp[i * BN], BN, 1, sizeof(T), 1, 8);
            }
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID3);
            DataFr<T, 1, BM> rfr(1, m);
            GlobalTensor<T> y_global;
            y_global.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(y));
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID3);
            rfr.Store(y_global, 0, bx, x3_tmp);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID4);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID4);
            Duplicate<T>(x2_tmp, 0.0, BM * BN);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
        }
    }
    if (OP == OP_ADD) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID1);
    }
    if (OP == OP_RDS) {
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID1);
    }
    PipeBarrier<PIPE_ALL>();
}

/******************************************************************************
 * PART 2: HOST CODE (CPU Execution)
 *****************************************************************************/

#include <cstdlib>
#include <cstdio>
#include <cstring>
#include "acl/acl.h"

// ACL 错误检查宏
#define ACL_CHECK(ret) do { \
    if (ret != ACL_SUCCESS) { \
        printf("ACL Error: %d at line %d\n", ret, __LINE__); \
        return -1; \
    } \
} while(0)

void initMatrixByBlocks(float* matrix, 
                         int m, int n, 
                         int M, int N, float start=0.0) {
    // 计算需要多少个子块（向上取整）
    int numBlockRows = (m + M - 1) / M;  // 行方向子块数
    int numBlockCols = (n + N - 1) / N;  // 列方向子块数
    
    // 填充矩阵
    for (int i = 0; i < m; ++i) {
        for (int j = 0; j < n; ++j) {
            // 确定当前位置属于哪个子块
            int blockRow = i / M;
            int blockCol = j / N;
            // 子块索引（从0开始递增）
            int blockIndex = blockRow * numBlockCols + blockCol + start;
            // 1维索引: i * n + j
            matrix[i * n + j] = static_cast<float>(blockIndex);
        }
    }
}

int main(int argc, char** argv)
{
    // 数据大小：64 个 float = 256 字节
    constexpr int32_t blkM = 32;
    constexpr int32_t blkN = 32;
    int32_t M = 16;
    int32_t N = 32;
    using T = float;
    const int32_t dataSize = M * N;
    const int32_t byteSize = dataSize * sizeof(T);
    
    printf("[Host] ========================================\n");
    printf("[Host] Static Tensor 算子测试启动\n");
    printf("[Host] 数据大小: %d float (%d bytes)\n", dataSize, byteSize);
    printf("[Host] DataCopyPad: blockLen=20, blockCount=8\n");
    printf("[Host] ========================================\n");

    // 分配 Host 内存并初始化数据
    T * x1Host = (T *)malloc(byteSize);
    T * x2Host = (T *)malloc(byteSize);
    T * yHost = (T *)malloc(byteSize);

    initMatrixByBlocks(x1Host, M, N, blkM, blkN, 1);
    initMatrixByBlocks(x2Host, M, N, blkM, blkN, 100);
    
    // y 初始化为 0
    for (int i = 0; i < dataSize; i++) {
        yHost[i] = 0.0f;
    }
    
    printf("[Host] Host 内存分配完成\n");
    printf("[Host] x[0..63] = 1.0, y[0..63] = 0.0\n");

    // 初始化 ACL 环境
    aclError ret = aclInit(nullptr);

    // 设置计算设备
    int32_t deviceId = 0;
    ret = aclrtSetDevice(deviceId);
    ACL_CHECK(ret);

    // 创建 Stream（任务队列）
    aclrtStream stream;
    ret = aclrtCreateStream(&stream);
    ACL_CHECK(ret);
    printf("[Host] Stream 创建成功\n");

    // 分配 Device 内存
    void* x1Device = nullptr;
    void* x2Device = nullptr;
    void* yDevice = nullptr;
    ret = aclrtMalloc(&x1Device, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ACL_CHECK(ret);
    ret = aclrtMalloc(&x2Device, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ACL_CHECK(ret);
    ret = aclrtMalloc(&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ACL_CHECK(ret);
    printf("[Host] Device 内存分配完成\n");

    // 将 x 从 Host 拷贝到 Device
    ret = aclrtMemcpy(x1Device, byteSize, x1Host, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    ACL_CHECK(ret);
    ret = aclrtMemcpy(x2Device, byteSize, x2Host, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    ACL_CHECK(ret);
    printf("[Host] x 数据 Host->Device 拷贝完成\n");
    printf("\n[Host] ========== 输入1 ==========");
    printf("\n                    ");
    for (int i = 0; i < dataSize; i++) {
        printf("%.1f ", x1Host[i]);
        if ((i + 1) % N == 0) {
            printf("\n                    ");
        }
    }
    printf("\n");
    printf("\n[Host] ========== 输入2 ==========");
    printf("\n                    ");
    for (int i = 0; i < dataSize; i++) {
        printf("%.1f ", x2Host[i]);
        if ((i + 1) % N == 0) {
            printf("\n                    ");
        }
    }
    printf("\n");
    

    // 调用 Kernel: <<<blockDim, smem, stream>>>(x, y)
    // 使用通用常量折叠框架 - 单入口调用，自动 AOT/运行时分发
    VecOpTiling til = {M, N, 1};
    auto tilPtr = reinterpret_cast<const uint8_t*>(&til);

    AOTDispatcher<VecOpTiling, VecOpTilingAOTRegistry>::template dispatch(
        // AOT_VecOpTiling_32x32_add_Value, // static
        tilPtr,                             // dynamic
        [&](auto tiling_holder, VecOpTiling value) {
            using Holder = decltype(tiling_holder);

            if constexpr (std::is_same_v<Holder, TilingRuntimeHolder>) {
                printf("##### 使用运行时 Tiling\n");
                tile_compute<float, blkM, blkN, Holder><<<1, nullptr, stream>>>(
                    (uint8_t*)x1Device, (uint8_t*)x2Device, (uint8_t*)yDevice, value);
            } else {
                printf("##### AOT matched! m=%d, n=%d, op=%d\n", Holder::value.m, Holder::value.n, Holder::value.op);
                tile_compute<float, blkM, blkN, Holder><<<1, nullptr, stream>>>(
                    (uint8_t*)x1Device, (uint8_t*)x2Device, (uint8_t*)yDevice, value);
            }
        }
    );
    printf("[Host] Kernel 启动成功\n");
    
    // 同步等待 Kernel 完成
    ret = aclrtSynchronizeStream(stream);
    ACL_CHECK(ret);
    printf("[Host] Kernel 执行完成\n");

    // 将 y 从 Device 拷贝回 Host
    ret = aclrtMemcpy(yHost, byteSize, yDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    ACL_CHECK(ret);
    printf("[Host] y 数据 Device->Host 拷贝完成\n");

    // 打印结果
    printf("\n[Host] ========== 结果输出 ==========");
    printf("\n                    ");
    for (int i = 0; i < dataSize; i++) {
        printf("%.1f ", yHost[i]);
        if ((i + 1) % N == 0) {
            printf("\n                    ");
        }
    }
    printf("\n");
    
    // 资源释放
    free(x1Host);
    free(x2Host);
    free(yHost);
    aclrtFree(x1Device);
    aclrtFree(x2Device);
    aclrtFree(yDevice);
    
    ret = aclrtDestroyStream(stream);
    ACL_CHECK(ret);
    
    ret = aclrtResetDevice(deviceId);
    ACL_CHECK(ret);
    
    ret = aclFinalize();
    ACL_CHECK(ret);
    
    printf("[Host] 资源释放完成，程序结束\n");

    return 0;
}


