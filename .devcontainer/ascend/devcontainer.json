{
  "name": "CANN 9.0.0-beta.2 Ascend NPU Dev",
  "image": "ghcr.io/yuanfang-chen/cann-container-image/cann:9.0.0-beta.2-910b-ubuntu22.04-py3.11",
  //"workspaceMount": "source=${localWorkspaceFolder},target=/workspace/ops-transformer,type=bind,consistency=cached",
  //"workspaceFolder": "/workspace/ops-transformer",
  "workspaceMount": "source=${localEnv:HOME}/code,target=${localEnv:HOME}/code,type=bind,consistency=cached",
  "workspaceFolder": "${localEnv:HOME}/code/worktrees/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind",
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=claude-config-${devcontainerId},target=/root/.claude,type=volume",
    "source=codex-config-${devcontainerId},target=/root/.codex,type=volume",
    "source=ccache-${devcontainerId},target=/root/.cache/ccache,type=volume"
  ],
  "runArgs": [
    // Codex CLI uses bubblewrap for Linux sandboxing. These unblock user
    // namespace creation on Ubuntu 24.04 hosts with AppArmor restrictions.
    "--security-opt=apparmor=unconfined",
    "--security-opt=seccomp=unconfined",
    // Ascend NPU device access. Add more --device=/dev/davinciN entries here
    // if the host exposes multiple NPUs that this devcontainer should use.
    "--device=/dev/davinci0",
    "--device=/dev/davinci_manager",
    "--device=/dev/devmm_svm",
    "--device=/dev/hisi_hdc",
    "--volume=/usr/local/dcmi:/usr/local/dcmi",
    "--volume=/usr/local/bin/npu-smi:/usr/local/bin/npu-smi",
    "--volume=/usr/local/Ascend/driver/lib64/:/usr/local/Ascend/driver/lib64/",
    "--volume=/usr/local/Ascend/driver/version.info:/usr/local/Ascend/driver/version.info",
    "--volume=/etc/ascend_install.info:/etc/ascend_install.info"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "streetsidesoftware.code-spell-checker",
        "ms-python.python",
        "charliermarsh.ruff",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "terminal.integrated.scrollback": 50000
      }
    }
  },
  "features": {
    // "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": ".devcontainer/install-dev.sh",
  "overrideCommand": true,
  "remoteUser": "root",
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}",
    "SSH_AUTH_SOCK": "/ssh-agent",
    "CCACHE_DIR": "/root/.cache/ccache",
    "CCACHE_MAXSIZE": "25Gi"
  }
}
