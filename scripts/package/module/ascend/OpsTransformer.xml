<?xml version="1.0" encoding="UTF-8"?>
<block name="OpsTransformer" copy_type="delivery" src_path="" dst_path="" install_path="" install_own="$username:$usergroup" install_mod="550" install_type="run;devel">
    <dir_info install_mod="550">
        <path value="$(TARGET_ENV)/lib64"/>
        <path value="$(TARGET_ENV)/include"/>
    </dir_info>
    <file_info value="opapi_transformer_lib" copy_type="delivery" src_path="build/"
        dst_path="built-in/op_impl/ai_core/tbe/op_api/lib/linux/$(ARCH)/"
        install_path="opp/built-in/op_impl/ai_core/tbe/op_api/lib/linux/$(ARCH)/" install_mod="555">
        <file value="libopapi_transformer.so"
            file_type="shared"
            install_softlink="$(TARGET_ENV)/lib64/libopapi_transformer.so"/>
    </file_info>
    <file_info value="opgraph_transformer_lib" copy_type="delivery" src_path="build/"
        dst_path="built-in/op_graph/lib/linux/$(ARCH)/"
        install_path="opp/built-in/op_graph/lib/linux/$(ARCH)/" install_mod="555">
        <file value="libopgraph_transformer.so"
            file_type="shared"
            install_softlink="$(TARGET_ENV)/lib64/libopgraph_transformer.so"/>
    </file_info>
    <file_info value="ophost_transformer_lib" copy_type="delivery" src_path="build/"
        dst_path="built-in/op_impl/ai_core/tbe/op_tiling/lib/linux/$(ARCH)/"
        install_path="opp/built-in/op_impl/ai_core/tbe/op_host/lib/linux/$(ARCH)/" install_mod="555">
        <file value="libophost_transformer.so"
            file_type="shared"
            install_softlink="$(TARGET_ENV)/lib64/libophost_transformer.so"/>
    </file_info>
    <file_info value="rtkb" copy_type="source" src_path="" dst_path="built-in/data" install_path="opp/built-in/data">
        <file value="op" entity="true" optional="true"/>
    </file_info>
    <dir_info value="rtkb_path" install_mod="750" install_type="all">
        <path value="opp/built-in/data"/>
        <path value="opp/built-in/data/op"/>
    </dir_info>
</block>
